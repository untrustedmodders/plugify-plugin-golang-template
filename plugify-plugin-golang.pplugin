{
  "$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
  "name": "golang_plugin",
  "version": "0.1.0",
  "description": "An example of a Go plugin. This can be used as a starting point when creating your own plugin.",
  "author": "untrustedmodders",
  "website": "https://github.com/untrustedmodders/",
  "license": "MIT",
  "entry": "plugify-plugin-golang",
  "language": "golang",
  "methods": [
    {
      "name": "MakePrint",
      "funcName": "__MakePrint",
      "paramTypes": [
        {
          "type": "int32",
          "name": "count"
        },
        {
          "type": "string",
          "name": "message"
        }
      ],
      "retType": {
        "type": "void"
      }
    }
  ]
}